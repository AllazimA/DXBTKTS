# DXB TKTS environment variables

# Public site URL (used for canonical URLs, sitemap and robots.txt)
NEXT_PUBLIC_SITE_URL=https://dxbtkts.com

# Payments (Roadmap Stage 3) — use TEST keys until the company licence is issued
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Booking desk at /admin (HTTP Basic auth). Without both, /admin returns 404.
# ADMIN_USER=
# ADMIN_PASSWORD=

# Key the DXB CRM uses to pull website requests (copy from CRM Settings → Website enquiries)
# CRM_SYNC_SECRET=
